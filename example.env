# Required
SLACK_TOKEN=xoxb-your-token
SLACK_USER_NOTIFY_CHANNEL=team-updates

# Slack Events API features
SLACK_SIGNING_SECRET=
SLACK_EVENTS_PATH=/api/slack/events

# AI chat and shower thoughts
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=debug
SERVER_PORT=4200
DATA_DIR=./tmp
CONFIG_FILE=./config.yaml

# Optional Slack preferences (comma-separated IDs)
SLACK_PREFERRED_USERS=
SLACK_PREFERRED_CHANNELS=

# Local Docker Compose stack
TIMEZONE=America/Denver
DOCKER_SUBNET=192.168.0.0/24
DOMAIN=example.com
ACME_EMAIL=me@example.com
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_DOMAIN_ZONE_ID=
CLOUDFLARE_API_TOKEN=
